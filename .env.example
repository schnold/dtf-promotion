# Optional. On Netlify, PUBLIC_SITE_URL overrides site.liveUrl and Netlify's automatic URL.
PUBLIC_SITE_URL=

# --- Admin (/admin) -------------------------------------------------------------------------
# Set these in Netlify under Project configuration → Environment variables. Never commit values.

# Better Auth signing secret, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# One-time code for creating the first admin account on /admin/login (at least 16 characters).
# Remove it in Netlify once the account exists.
ADMIN_SETUP_TOKEN=

# Netlify Database connection. Netlify sets it automatically in production, deploy previews and
# `netlify dev` / `npm run dev` (local database). Only set it by hand for scripts such as
# `npm run auth:schema`.
NETLIFY_DB_URL=
