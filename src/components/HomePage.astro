---
import '@fontsource-variable/archivo';
import '@fontsource-variable/syne';
import '../styles/global.css';
import { ArrowUpRight, Boxes, Factory, FileCheck, FileImage, Flame, Hand, MapPin, MoveRight, Palette, Ruler, Shirt, Store, Thermometer, Timer, Upload, Users, WashingMachine } from '@lucide/astro';
import { absoluteSiteUrl, buildSeoDescription, buildSeoTitle, type SiteView } from '../lib/site';
import { fill } from '../lib/cms';
import SeliniLogo from './SeliniLogo.astro';
import SocialIcon from './SocialIcon.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  /** Published content (live page) or the draft (admin preview). */
  view: SiteView;
  /** Admin preview: noindex and a banner. */
  preview?: boolean;
}

const { view, preview = false } = Astro.props;
const { cms, settings, COMPANY, SHOP, SITE_NAME } = view;
const page = cms.pages.home;
const { header, logo } = cms.site;

const canonicalUrl = absoluteSiteUrl(Astro.request, '/', cms);
const ogImage = page.seo.ogImage;
const socialImageUrl = absoluteSiteUrl(Astro.request, ogImage.src, cms);
const heroImage = page.hero.image;
const formatDimension = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 });
const formatPrice = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const basePriceLabel = formatPrice.format(settings.basePricePerMeter);
const rollWidthLabel = formatDimension.format(settings.rollWidthCm);
const lowestTier = settings.tiers[settings.tiers.length - 1];
const lowestTierLabel = formatPrice.format(lowestTier.pricePerMeter);
const pageTitle = buildSeoTitle(cms, basePriceLabel);
const pageDescription = buildSeoDescription(cms, basePriceLabel, lowestTierLabel);
const priceStand = fill(page.common.priceStand, { priceUpdated: settings.priceUpdatedLabel });

/** Values that cms.json templates may use as `{token}`; all of them are computed from the price settings. */
const tokens = {
  price: basePriceLabel,
  rollWidth: rollWidthLabel,
  lowestTierPrice: lowestTierLabel,
  priceStand,
  priceUpdated: settings.priceUpdatedLabel,
  delivery: settings.deliveryLabel,
  years: settings.experienceYears,
  location: settings.locationLabel,
  dpi: settings.recommendedDpi,
  rollArea: formatPrice.format(settings.rollWidthCm / 100),
};
const t = (template: string) => fill(template, tokens);

const icons = { Boxes, Factory, FileCheck, FileImage, Flame, Hand, Palette, Ruler, Shirt, Store, Thermometer, Timer, Upload, Users };
const iconFor = (name: string) => icons[name as keyof typeof icons] ?? Shirt;

const priceFormats = settings.formats.map((format) => ({
  ...format,
  size: `${formatDimension.format(format.widthCm)} × ${formatDimension.format(format.heightCm)} cm`,
  area: (format.widthCm * format.heightCm) / 10_000,
}));
const defaultFormatIndex = Math.min(2, priceFormats.length - 1);
const defaultFormat = priceFormats[defaultFormatIndex];
const initialQuantity = Math.min(10, settings.maxQuantity);
const initialArea = defaultFormat.area * initialQuantity;
const initialMeters = initialArea / (settings.rollWidthCm / 100);
const initialEstimate = defaultFormat.unitPrice * initialQuantity;
const initialEstimateLabel = formatPrice.format(initialEstimate);
const initialEstimateLength = initialEstimateLabel.length >= 12 ? 'very-long' : initialEstimateLabel.length >= 8 ? 'long' : 'default';

const tiers = settings.tiers.map((tier) => ({
  ...tier,
  discount: Math.round((1 - tier.pricePerMeter / settings.basePricePerMeter) * 100),
}));

// B2B bundles as listed on the shop (cms.json `shared.bundles`): fixed products, not editable tiers.
const bundles = cms.shared.bundles.items;

const facts = page.facts.items.map((fact) => [t(fact.value), t(fact.label)]);
const tickerColors = ['text-pink', 'text-blue'];
const tickerItems = page.ticker.items.map((label, i) => [t(label), tickerColors[i % tickerColors.length]]);
const headerLinkColors = ['hover:text-yellow', 'hover:text-cyan', 'hover:text-pink'];

const pressSteps = page.pressing.steps.map((step, i) => [iconFor(step.icon), String(i + 1), t(step.title), t(step.text)] as const);

const fileRules = page.files.rules.map((rule) => [iconFor(rule.icon), t(rule.title), t(rule.text)] as const);

const comparison = page.comparison.rows.map((row) => [row.question, row.dtf, row.screenPrint, row.sublimation] as const);

const audienceTones = ['bg-paper', 'bg-pink text-white', 'bg-ink text-white', 'bg-paper'];
const audiences = page.audiences.items.map((audience, i) => ({
  icon: iconFor(audience.icon),
  title: t(audience.title),
  text: t(audience.text),
  links: audience.links.map((link) => [link.label, link.href] as const),
  tone: audienceTones[i % audienceTones.length],
}));

const faqs: Array<[string, string]> = page.faq.items.map((item) => [t(item.question), t(item.answer)]);

const businessId = `${canonicalUrl}#business`;
const productId = `${canonicalUrl}#product`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': businessId,
      name: COMPANY.brand,
      legalName: COMPANY.legalName,
      url: SHOP.home,
      logo: absoluteSiteUrl(Astro.request, '/brand/selini-shirt-logo-black.png', cms),
      image: socialImageUrl,
      telephone: COMPANY.phoneE164,
      email: COMPANY.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: COMPANY.street,
        postalCode: COMPANY.postalCode,
        addressLocality: COMPANY.city,
        addressCountry: 'DE',
      },
      areaServed: page.structuredData.areaServed,
      sameAs: [...COMPANY.social.map((link) => link.href), COMPANY.googleRatingUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: SITE_NAME,
      inLanguage: 'de-DE',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'de-DE',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': productId },
      primaryImageOfPage: socialImageUrl,
    },
    {
      '@type': 'Product',
      '@id': productId,
      name: page.structuredData.productName,
      description: t(page.structuredData.productDescription),
      image: socialImageUrl,
      brand: { '@type': 'Brand', name: COMPANY.brand },
      category: page.structuredData.productCategory,
      offers: {
        '@type': 'Offer',
        url: SHOP.meterware,
        price: settings.basePricePerMeter.toFixed(2),
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        seller: { '@id': businessId },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: COMPANY.brand, item: SHOP.home },
        { '@type': 'ListItem', position: 2, name: page.structuredData.breadcrumbServiceName, item: SHOP.dtfService },
        { '@type': 'ListItem', position: 3, name: page.structuredData.breadcrumbPageName, item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={preview ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#090a0c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" type="image/webp" href={heroImage.src} fetchpriority="high" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{cms.site.skipLink}</a>
    {preview && <p class="preview-banner" role="status">Vorschau des Entwurfs – nicht öffentlich. <a href="/admin">Zurück zum Admin</a></p>}
    <div class="rainbow-line fixed inset-x-0 top-0 z-[70] h-1"></div>

    <div class="overflow-hidden border-b border-white/15 bg-paper py-2 text-ink" role="region" aria-label={page.ticker.ariaLabel}>
      <p class="sr-only">{t(page.ticker.srText)}</p>
      <div class="ticker-track whitespace-nowrap text-[11px] font-bold tracking-[.12em]" aria-hidden="true">
        {Array.from({ length: 2 }).map(() => (
          <div class="ticker-group">
            {Array.from({ length: 2 }).flatMap(() => tickerItems).map(([label, color]) => (
              <><span>{label}</span><span class={color}>✦</span></>
            ))}
          </div>
        ))}
      </div>
    </div>

    <header class="absolute inset-x-0 top-9 z-50">
      <nav class="container-shell flex items-center justify-between py-5" aria-label={header.ariaLabel}>
        <div class="flex items-center gap-3 sm:gap-4">
          <a href="#top" class="font-display text-lg font-extrabold tracking-[-.06em] sm:text-2xl">{logo.first}<span class="text-yellow">/</span><span class="hidden min-[390px]:inline">{logo.second}</span><span class="min-[390px]:hidden">{logo.secondShort}</span></a>
          <span class="h-7 w-px bg-white/25" aria-hidden="true"></span>
          <SeliniLogo href={SHOP.home} height={34} prefix="by" class="[&>span]:hidden sm:[&>span]:inline [&>img]:h-[26px] [&>img]:w-auto sm:[&>img]:h-[34px] hover:opacity-80" />
        </div>
        <div class="hidden items-center gap-8 text-sm font-semibold lg:flex">
          {header.links.map((link, i) => (
            <a href={link.href} class={headerLinkColors[i % headerLinkColors.length]}>{link.label}</a>
          ))}
        </div>
        <a href={SHOP.meterware} rel="noopener" class="btn h-11 min-h-11 rounded-none border-0 bg-yellow px-5 text-sm font-bold text-ink shadow-none hover:bg-white">
          <span class="hidden sm:inline">{header.ctaPrefix} </span>{header.ctaLabel} <ArrowUpRight size={17} stroke-width={2.5} />
        </a>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <span id="top" class="sr-only" aria-hidden="true"></span>
      <section class="relative min-h-[920px] overflow-hidden border-b border-white/20 bg-black sm:min-h-[860px]">
        <img src={heroImage.src} width={heroImage.width} height={heroImage.height} fetchpriority="high" alt={heroImage.alt} class="absolute inset-0 h-full w-full object-cover object-[58%_center] opacity-80" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,#090a0c_0%,rgba(9,10,12,.9)_30%,rgba(9,10,12,.3)_62%,rgba(9,10,12,.42)_100%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(0deg,#090a0c_0%,transparent_30%)]"></div>

        <div class="container-shell relative z-10 flex min-h-[920px] flex-col justify-end pb-10 pt-40 sm:min-h-[860px] sm:pb-14">
          <div class="mb-auto flex items-center gap-3 pt-20 text-sm font-semibold sm:pt-16">
            <span class="inline-block size-2 animate-pulse rounded-full bg-cyan"></span>
            {page.hero.eyebrow}
          </div>

          <div class="max-w-[1100px]">
            <!-- Sized to the h1's own width (container units): "bestellen." is ~10.2em wide in this font, so 1/10.4 of the width always fits. -->
            <h1 class="hero-word uppercase [container-type:inline-size]">
              <span class="block text-[clamp(1.75rem,calc(100cqi/10.4),10rem)]">{page.hero.h1Line1}</span>
              <span class="ink-outline block text-[clamp(1.75rem,calc(100cqi/10.4),10rem)]">{page.hero.h1Line2}</span>
              <span class="mt-5 block font-display text-base font-bold normal-case tracking-normal text-yellow sm:text-xl">{t(page.hero.subline)}</span>
            </h1>
            <div class="mt-8 grid gap-8 border-t border-white/40 pt-6 md:grid-cols-[1fr_auto] md:items-end">
              <p class="max-w-2xl text-lg leading-relaxed text-white/80 sm:text-xl">
                {t(page.hero.lead)}
              </p>
              <div class="flex flex-wrap gap-3">
                <a href={SHOP.meterware} rel="noopener" class="btn h-14 min-h-14 rounded-none border-0 bg-pink px-7 font-bold text-white shadow-none hover:bg-yellow hover:text-ink">{page.hero.ctaLabel} <MoveRight size={19} /></a>
                <a href="#preise" class="btn h-14 min-h-14 rounded-none border border-white/50 bg-black/20 px-6 text-white backdrop-blur-md hover:bg-white hover:text-ink">{page.hero.secondaryCtaLabel}</a>
              </div>
            </div>
          </div>

          <div class="mt-12 flex items-center justify-between text-xs font-bold text-white/65">
            <span>{page.hero.scrollHint}</span>
            <span class="hidden items-center gap-2 sm:flex"><Shirt size={17} /> {page.hero.materials}</span>
          </div>
        </div>
      </section>

      <section class="border-b border-white/20 bg-paper text-ink" aria-label={page.facts.ariaLabel}>
        <div class="container-shell grid grid-cols-2 lg:grid-cols-4">
          {facts.map(([value, label], i) => (
            <div class:list={["min-w-0 px-4 py-8 sm:px-8 sm:py-11", i % 2 === 0 ? 'border-r border-black/20' : '', i < 2 ? 'border-b border-black/20 lg:border-b-0' : '', i === 1 ? 'lg:border-r' : '', i === 2 ? 'lg:border-r' : '']}>
              <div class="fact-value font-display font-extrabold tracking-[-.05em]">{value}</div>
              <div class="mt-2 text-xs font-semibold text-black/60 sm:text-sm">{label}</div>
            </div>
          ))}
        </div>
      </section>

      <section id="preise" class="bg-blue py-20 text-white sm:py-28">
        <div class="container-shell">
          <div class="reveal grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
            <div>
              <span class="font-display text-sm font-bold">{page.pricing.eyebrow}</span>
              <h2 class="font-display mt-4 max-w-3xl text-5xl font-extrabold leading-[.92] tracking-[-.065em] sm:text-7xl">{page.pricing.title}</h2>
            </div>
            <p class="max-w-2xl text-lg leading-relaxed text-white/75 lg:justify-self-end">{t(page.pricing.intro)}</p>
          </div>

          <div class="reveal mt-12 grid overflow-hidden border-2 border-white bg-ink lg:grid-cols-[1.1fr_.9fr]">
            <div class="p-5 sm:p-9 lg:p-12">
              <p class="mb-5 text-sm font-bold">{page.pricing.formatLabel}</p>
              <div class="flex flex-wrap gap-2" id="format-tabs">
                {priceFormats.map((item, i) => (
                  <button type="button" class="price-tab min-w-16 border border-white/30 px-4 py-3 font-display text-lg font-bold transition-colors hover:border-yellow" data-format={item.key} data-area={item.area} data-unit-price={item.unitPrice} data-size={item.size} aria-label={fill(page.pricing.formatAriaLabel, { format: item.key, size: item.size, unitPrice: formatPrice.format(item.unitPrice) })} aria-pressed={i === defaultFormatIndex ? 'true' : 'false'}>{item.key}</button>
                ))}
              </div>

              <div class="mt-10">
                <div class="mb-4 flex items-end justify-between gap-4">
                  <label for="quantity" class="text-sm font-bold">{page.pricing.quantityLabel}</label>
                  <output id="quantity-output" for="quantity" class="font-display text-4xl font-extrabold">{initialQuantity}×</output>
                </div>
                <input id="quantity" type="range" min="1" max={settings.maxQuantity} value={initialQuantity} class="range range-warning range-sm w-full" aria-label={page.pricing.quantityAriaLabel} />
                <div class="mt-3 flex justify-between text-xs text-white/50"><span>1</span><span>{settings.maxQuantity}</span></div>
              </div>

              <div class="mt-10 grid gap-px bg-white/20 sm:grid-cols-2">
                <div class="bg-ink p-5"><span class="text-xs text-white/55">{page.pricing.sizeLabel}</span><strong id="selected-size" class="mt-2 block text-lg">{defaultFormat.size}</strong></div>
                <div class="bg-ink p-5"><span class="text-xs text-white/55">{page.pricing.areaLabel}</span><strong id="total-area" class="mt-2 block text-lg" data-roll-width={settings.rollWidthCm}>{formatPrice.format(initialArea)} m² ≈ {formatPrice.format(initialMeters)} lfm</strong></div>
              </div>
            </div>

            <aside class="price-result relative flex min-h-[410px] min-w-0 flex-col justify-between overflow-hidden bg-yellow p-6 text-ink sm:p-12">
              <div class="absolute -right-16 -top-16 size-56 rounded-full bg-pink mix-blend-multiply blur-2xl"></div>
              <div class="relative">
                <p class="text-sm font-bold">{page.pricing.resultEyebrow}</p>
                <div class="mt-7 flex min-w-0 items-start" aria-live="polite" aria-atomic="true">
                  <span class="mt-1 shrink-0 text-xl font-bold sm:mt-2 sm:text-2xl">€</span>
                  <strong id="estimate" class="price-number min-w-0 font-display font-extrabold leading-none" data-length={initialEstimateLength}>{initialEstimateLabel}</strong>
                </div>
                <p class="mt-3 max-w-sm text-sm leading-relaxed text-black/65">{t(page.pricing.resultNote)}</p>
              </div>
              <a href={SHOP.meterware} rel="noopener" class="btn relative mt-8 h-14 min-h-14 w-full rounded-none border-0 bg-ink text-white hover:bg-pink">{t(page.pricing.resultCtaLabel)} <ArrowUpRight size={18} /></a>
            </aside>
          </div>

          <div class="reveal mt-12 grid gap-8 lg:grid-cols-[1fr_.9fr] lg:items-start">
            <div class="overflow-hidden border-2 border-white bg-ink">
              <div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-white px-5 py-4 sm:px-7">
                <h3 class="font-display text-2xl font-extrabold tracking-[-.04em]">{page.pricing.tiersTitle}</h3>
                <span class="text-xs font-bold text-white/60">{priceStand.toUpperCase()}</span>
              </div>
              <table class="price-table w-full border-collapse text-left">
                <thead>
                  <tr class="text-xs text-white/55">
                    <th scope="col" class="px-5 py-3 font-bold sm:px-7">{page.pricing.tiersQuantityHeader}</th>
                    <th scope="col" class="px-5 py-3 text-right font-bold sm:px-7">{page.pricing.tiersPriceHeader}</th>
                    <th scope="col" class="px-5 py-3 text-right font-bold sm:px-7">{page.pricing.tiersDiscountHeader}</th>
                  </tr>
                </thead>
                <tbody>
                  {tiers.map((tier) => (
                    <tr class="border-t border-white/20">
                      <td class="px-5 py-3 font-display text-lg font-bold sm:px-7">{tier.quantity} m</td>
                      <td class="px-5 py-3 text-right font-display text-lg font-bold tabular-nums sm:px-7">{formatPrice.format(tier.pricePerMeter)} €</td>
                      <td class:list={["px-5 py-3 text-right text-sm font-bold tabular-nums sm:px-7", tier.discount > 0 ? 'text-cyan' : 'text-white/40']}>{tier.discount > 0 ? `−${tier.discount} %` : page.pricing.tierBaseLabel}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="border-2 border-white bg-paper p-6 text-ink sm:p-8">
              <p class="text-sm font-bold">{page.pricing.bundlesEyebrow}</p>
              <h3 class="font-display mt-3 text-2xl font-extrabold tracking-[-.04em]">{page.pricing.bundlesTitle}</h3>
              <p class="mt-3 text-sm leading-relaxed text-black/65">{t(page.pricing.bundlesText)}</p>
              <ul class="mt-6 divide-y-2 divide-ink border-y-2 border-ink">
                {bundles.map((bundle) => (
                  <li>
                    <a href={bundle.href} rel="noopener" class="group flex items-center justify-between gap-4 py-4 font-bold hover:text-pink">
                      <span class="font-display text-xl">{fill(page.pricing.bundleItemLabel, { meters: bundle.meters })}</span>
                      <span class="flex items-center gap-3 tabular-nums"><span>{formatPrice.format(bundle.price)} €/m</span><ArrowUpRight size={18} class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" /></span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href={SHOP.bundleCategory} rel="noopener" class="mt-6 inline-flex items-center gap-2 border-b-2 border-ink pb-1 text-sm font-bold hover:border-pink hover:text-pink">{page.pricing.bundlesLinkLabel} <ArrowUpRight size={16} /></a>
            </div>
          </div>

          <div class="mt-5 flex flex-col gap-3 text-xs text-white/65 sm:flex-row sm:items-center sm:justify-between">
            <p>{t(page.pricing.footnote)}</p>
            <p>{page.pricing.footnoteShipping}</p>
          </div>
        </div>
      </section>

      <section id="produktion" class="overflow-hidden bg-paper py-20 text-ink sm:py-28">
        <div class="container-shell">
          <div class="reveal grid gap-12 lg:grid-cols-2 lg:items-center">
            <div>
              <div class="flex items-center gap-3 text-sm font-bold"><Factory size={20} /> {page.production.eyebrow}</div>
              <h2 class="font-display mt-6 text-5xl font-extrabold leading-[.93] tracking-[-.065em] sm:text-7xl">{page.production.title}</h2>
              <p class="mt-7 max-w-xl text-lg leading-relaxed text-black/65">{t(page.production.text)}</p>
              <div class="mt-9 flex flex-wrap gap-3">
                {page.production.badges.map((badge) => (
                  <span class="badge h-auto rounded-none border-black px-4 py-3 font-semibold">{badge}</span>
                ))}
              </div>
              <div class="mt-9 flex flex-wrap gap-x-8 gap-y-3 text-sm font-bold">
                <a href={SHOP.dtfService} rel="noopener" class="inline-flex items-center gap-2 border-b-2 border-ink pb-1 hover:border-pink hover:text-pink">{page.production.serviceLinkLabel} <ArrowUpRight size={16} /></a>
                <a href={SHOP.about} rel="noopener" class="inline-flex items-center gap-2 border-b-2 border-ink pb-1 hover:border-pink hover:text-pink">{page.production.aboutLinkLabel} <ArrowUpRight size={16} /></a>
              </div>
            </div>

            <figure class="relative border-2 border-ink bg-ink p-3 shadow-[10px_10px_0_#ff2b91] sm:p-5 sm:shadow-[14px_14px_0_#ff2b91]">
              <div class="overflow-hidden">
