---
import { ArrowUpRight, Lock, Star } from '@lucide/astro';
import { fill } from '../lib/cms';
import type { SiteView } from '../lib/site';
import BerlinBear from './BerlinBear.astro';
import SeliniLogo from './SeliniLogo.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  view: SiteView;
  /** Target of the footer wordmark: `#top` on the landing page, `/` on every other page. */
  homeHref?: string;
}

const { view, homeHref = '/' } = Astro.props;
const { cms, settings, COMPANY, LEGAL_LINKS, SHOP } = view;
const { footer, logo } = cms.site;

const currentYear = new Date().getFullYear();
const priceStand = fill(cms.pages.home.common.priceStand, { priceUpdated: settings.priceUpdatedLabel });
// Same set and order as the selini-shirt.de footer: WhatsApp first, then the social profiles.
const socialLinks = [{ label: 'WhatsApp', href: COMPANY.whatsapp }, ...COMPANY.social];
// Filled spheres like selini-shirt.de; WhatsApp in its brand green so it stands out.
const sphere = 'inline-flex size-10 items-center justify-center rounded-full border transition-colors';
const sphereStyle = (label: string) =>
  label === 'WhatsApp'
    ? 'border-[#25D366] bg-[#25D366] text-ink hover:border-[#1ebe57] hover:bg-[#1ebe57]'
    : 'border-white/15 bg-paper text-ink/65 hover:border-yellow hover:bg-yellow hover:text-ink';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class="site-footer relative border-t border-white/20 bg-ink py-12 text-white sm:py-16">
  <div class="container-shell grid gap-12 border-b border-white/20 pb-12 md:grid-cols-2 xl:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href={homeHref} class="font-display text-2xl font-extrabold tracking-[-.06em]">{logo.first}<span class="text-yellow">/</span>{logo.second}</a>
      <div class="mt-5 flex items-center gap-3">
        <span class="text-xs font-bold uppercase tracking-[.14em] text-white/45">Ein Angebot von</span>
        <SeliniLogo href={SHOP.home} height={40} class="hover:opacity-80" />
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/55">{footer.text}</p>
      <a href={COMPANY.googleRatingUrl} rel="noopener" class="mt-5 inline-flex items-center gap-2 text-sm font-bold hover:text-yellow"><Star size={16} class="text-yellow" /> {fill(footer.ratingLabel, { rating: COMPANY.googleRating })}</a>
      <a href={SHOP.meterware} rel="noopener" class="mt-4 flex items-center gap-2 font-bold text-yellow hover:text-white">{footer.shopCtaLabel} <ArrowUpRight size={16} /></a>
    </div>
    <div>
      <h2 class="text-sm font-bold text-white/45">{footer.contactTitle}</h2>
      <address class="mt-4 space-y-2 text-sm not-italic leading-relaxed">
        <p>{COMPANY.legalName}<br/>{COMPANY.street}<br/>{COMPANY.postalCode} {COMPANY.city} ({COMPANY.district})</p>
        <a class="block hover:text-cyan" href={COMPANY.phoneHref}>{COMPANY.phoneDisplay}</a>
        <a class="block break-all hover:text-cyan" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        <a class="block hover:text-cyan" href={COMPANY.whatsapp} rel="noopener">{footer.whatsappLabel}</a>
      </address>
      <nav class="mt-5 flex flex-wrap gap-3" aria-label={footer.socialAriaLabel}>
        {socialLinks.map((link) => (
          <a href={link.href} rel="noopener" target="_blank" aria-label={link.label} title={link.label} class:list={[sphere, sphereStyle(link.label)]}>
            <SocialIcon name={link.label} size={18} />
          </a>
        ))}
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-bold text-white/45">{footer.shopNavTitle}</h2>
      <nav class="mt-4 flex flex-col items-start gap-3 text-sm" aria-label={footer.shopNavAriaLabel}>
        {footer.shopLinks.map((link) => (
          <a href={link.href} rel="noopener" class="hover:text-cyan">{link.label}</a>
        ))}
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-bold text-white/45">{footer.legalNavTitle}</h2>
      <nav class="mt-4 flex flex-col items-start gap-3 text-sm" aria-label={footer.legalNavAriaLabel}>
        {LEGAL_LINKS.map((link) => (
          <a
            href={link.href}
            rel={link.external ? 'noopener' : undefined}
            aria-current={link.href === currentPath ? 'page' : undefined}
            class="inline-flex items-center gap-1 hover:text-cyan aria-[current=page]:text-yellow"
          >{link.label}{link.external && <ArrowUpRight size={14} aria-hidden="true" />}</a>
        ))}
      </nav>
    </div>
  </div>
  <div class="container-shell flex flex-col gap-3 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
    <p>{fill(footer.copyright, { year: currentYear, legalName: COMPANY.legalName, priceStand })}</p>
    <p class="flex items-center gap-2">{footer.madeIn} <BerlinBear class="h-5 w-auto text-paper/80" /></p>
  </div>
  {/* Admin entry: desktop only, in the footer's bottom-right corner, same colour as the footer until hovered or focused. */}
  <a href="/admin" rel="nofollow" aria-label="Admin-Anmeldung" title="Admin" class="absolute right-2 bottom-2 hidden p-1 text-ink transition-colors hover:text-white focus-visible:text-white lg:inline-flex">
    <Lock size={16} aria-hidden="true" />
  </a>
</footer>
