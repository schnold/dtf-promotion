---
import HomePage from '../components/HomePage.astro';
import { getPublishedContent, publicCacheHeaders } from '../lib/content';

export const prerender = false;

// Published content from the admin (/admin); the bundled cms.json until the first publish.
const content = await getPublishedContent();
publicCacheHeaders(Astro.response.headers, content);
---

<HomePage view={content.view} />
