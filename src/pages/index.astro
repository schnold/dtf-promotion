      </div>
      <div class="container-shell flex flex-col gap-3 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
        <p>© {currentYear} BYSELINI UG. Alle Rechte vorbehalten.</p>
        <p>Made in Berlin</p>
      </div>
    </footer>

    <script is:inline nonce={Astro.locals.cspNonce}>
      const tabs = [...document.querySelectorAll('.price-tab')];
      const slider = document.querySelector('#quantity');
      const quantityOutput = document.querySelector('#quantity-output');
      const estimate = document.querySelector('#estimate');
      const selectedSize = document.querySelector('#selected-size');
      const totalArea = document.querySelector('#total-area');
      let selected = tabs.find((tab) => tab.getAttribute('aria-pressed') === 'true') ?? tabs[0];

      const formatNumber = (value) => new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);
      const updatePrice = () => {
        if (!slider || !quantityOutput || !estimate || !selectedSize || !totalArea || !selected) return;
        const quantity = Number(slider.value);
        const area = Number(selected.dataset.area);
        const unitPrice = Number(selected.dataset.unitPrice);
        const calculatedArea = area * quantity;
        quantityOutput.value = `${quantity}×`;
        selectedSize.textContent = selected.dataset.size ?? '';
        totalArea.textContent = `${formatNumber(calculatedArea)} m²`;
        const formattedEstimate = formatNumber(unitPrice * quantity);
        estimate.textContent = formattedEstimate;
        estimate.dataset.length = formattedEstimate.length >= 12 ? 'very-long' : formattedEstimate.length >= 8 ? 'long' : 'default';
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => {
        tabs.forEach((item) => item.setAttribute('aria-pressed', 'false'));
        tab.setAttribute('aria-pressed', 'true');
        selected = tab;
        updatePrice();
      }));
      slider?.addEventListener('input', updatePrice);
      updatePrice();

      const revealElements = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: .13 });
        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
