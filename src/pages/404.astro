---
import '@fontsource-variable/archivo';
import '@fontsource-variable/syne';
import '../styles/global.css';
import ScrollRail from '../components/ScrollRail.astro';
import SeliniLogo from '../components/SeliniLogo.astro';
import { getPublishedContent } from '../lib/content';

export const prerender = false;

const { view } = await getPublishedContent();
const { cms, SHOP } = view;
const page = cms.pages.notFound;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#090a0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{page.seo.title}</title>
  </head>
  <body class="min-h-screen bg-ink text-paper">
    <ScrollRail />
    <main class="container-shell flex min-h-screen flex-col justify-center py-16">
      <SeliniLogo href={SHOP.home} height={36} prefix="by" class="mb-10 self-start hover:opacity-80" />
      <p class="text-sm font-bold text-cyan">{page.content.eyebrow}</p>
      <h1 class="font-display mt-5 text-[clamp(4rem,18vw,12rem)] font-extrabold leading-[.82] tracking-[-.075em]" set:html={page.content.h1} />
      <p class="mt-8 max-w-lg text-lg leading-relaxed text-white/65">{page.content.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn h-14 min-h-14 rounded-none border-0 bg-yellow px-7 font-bold text-ink hover:bg-white">{page.content.homeCtaLabel}</a>
        <a href={SHOP.meterware} rel="noopener" class="btn h-14 min-h-14 rounded-none border border-white/40 bg-transparent px-7 font-bold text-white hover:bg-pink">{page.content.shopCtaLabel}</a>
      </div>
    </main>
  </body>
</html>
